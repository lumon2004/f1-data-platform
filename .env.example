# Copia questo file in .env e compila i valori. .env non va mai versionato.

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Kaggle — scegli UNA delle due forme (oppure usa ~/.kaggle/kaggle.json)
# Token singolo:
KAGGLE_API_TOKEN=
# Forma legacy username + key:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
