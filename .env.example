# Copia questo file in .env e compila i valori. .env non va mai versionato.

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Porte pubblicate sull'host da API e dashboard (facoltative: valori predefiniti qui sotto)
API_PORT=8080
WEB_PORT=8081

# Kaggle — scegli UNA delle due forme (la pipeline legge solo queste variabili d'ambiente)
# Token singolo:
KAGGLE_API_TOKEN=
# Forma legacy username + key:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
